@model Employee; //needed for form tag helper binding
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>


@* //anchor tag helper *@
<a asp-controller="Home" asp-action="Contact">tag helpers</a>

@* if you want to pass id *@

<a asp-controller="Home" asp-action="ContactId" asp-route-id="5">tag helpers with id</a>

<br />
@* //image tag helper *@
<img src="~/images/img.jpg" asp-append-version="true" width="100px" alt="Company Logo" />

@* //complete form using tag helpers *@
@* note: The form will post back to the same URL (same controller action) that rendered the view.

Example:

Let’s say your current view is /Category/Create, and you write:
post request to /Category/Create *@


<form asp-controller="Home"  asp-action="Index" method="post" class="mt-4">
    <div class="form-group mb-3">
        @* input *@
        @* no need to specify input type *@
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Enter your name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    @* dropdown *@
    <div class="form-group mb-3">
        <label asp-for="Gender" class="form-label"></label>
        <select asp-for="Gender" class="form-select"
                asp-items="Html.GetEnumSelectList<Gender>()">
            <option value="">-- Select Gender --</option>
        </select>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>
    <!-- Marital Status Radio Buttons -->
    <div class="form-group mb-3">
        <label asp-for="MaritalStatus" class="form-label d-block">Marital Status</label>

        <div class="form-check form-check-inline">
            <input asp-for="MaritalStatus" class="form-check-input" type="radio" value="Married" id="married" />
            <label class="form-check-label" for="married">Married</label>
        </div>

        <div class="form-check form-check-inline">
            <input asp-for="MaritalStatus" class="form-check-input" type="radio" value="Unmarried" id="unmarried" />
            <label class="form-check-label" for="unmarried">Unmarried</label>
        </div>

        <span asp-validation-for="MaritalStatus" class="text-danger"></span>
    </div>

    <!-- Address TextArea -->
    <div class="form-group mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter your address"></textarea>
       
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>